# Copy to .env and adjust. All variables are optional; defaults suit local single-user use.
# Never commit .env.

# docker compose only: database password and host port
# AETHER_DB_PASSWORD=change-me
# AETHER_PORT=8000

# Metadata database. Default: SQLite file under ./storage (single-user profile).
# PostgreSQL (primary deployment):
# AETHER_DATABASE_URL=postgresql+psycopg://aether:CHANGE_ME@127.0.0.1:5432/aether
# AETHER_DATABASE_URL=sqlite:///./storage/aether.db

# Where uploads, Parquet dataset versions and exports are stored
# AETHER_STORAGE_DIR=./storage

# embedded (worker thread inside the API) | external (run `aether worker` separately)
AETHER_WORKER_MODE=embedded

# Set to true whenever the app is served over HTTPS (required for any non-local deployment)
AETHER_COOKIE_SECURE=false
# Allow self-registration after the first account exists
AETHER_ALLOW_REGISTRATION=true
AETHER_SESSION_TTL_HOURS=168

# Limits
AETHER_MAX_UPLOAD_MB=512
AETHER_QUERY_TIMEOUT_SECONDS=30
AETHER_QUERY_MEMORY_LIMIT=2GB
AETHER_MAX_RESULT_ROWS=10000

AETHER_LOG_LEVEL=INFO
AETHER_LOG_JSON=true
